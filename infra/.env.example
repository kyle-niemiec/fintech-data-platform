# PostgreSQL configuration info
POSTGRES_DB=fintech_platform

# Dedicated event-store database (append-only audit persistence)
EVENT_STORE_DB=fintech_event_store
EVENT_STORE_DB_PORT=5433
EVENT_STORE_DB_ROOT_USER=fintech_event_store_admin
EVENT_STORE_DB_ROOT_PASSWORD=replace_with_event_store_pg_pass

# PostreSQL root user login
POSTGRES_ROOT_PASSWORD=replace_with_pg_pass
POSTGRES_ROOT_USER=fintech_platform_admin

# Event backbone
REDPANDA_BOOTSTRAP_SERVERS=redpanda:9092
REDPANDA_ADMIN_HOSTS=redpanda:9644
REDPANDA_ADMIN_USER=
REDPANDA_ADMIN_PASSWORD=
REDPANDA_INGEST_TOPIC_PARTITIONS=6
REDPANDA_PIPELINE_TOPIC_PARTITIONS=6
REDPANDA_CDC_TOPIC_PARTITIONS=12
REDPANDA_ALERT_TOPIC_PARTITIONS=3

REDPANDA_EXCEL_SERVICE_USER=rp_excel_service
REDPANDA_EXCEL_SERVICE_PASSWORD=replace_with_redpanda_excel_service_password

REDPANDA_EXCEL_SCANNER_USER=rp_excel_scanner
REDPANDA_EXCEL_SCANNER_PASSWORD=replace_with_redpanda_excel_scanner_password

REDPANDA_EXCEL_BRONZE_USER=rp_excel_bronze
REDPANDA_EXCEL_BRONZE_PASSWORD=replace_with_redpanda_excel_bronze_password

REDPANDA_AIRFLOW_USER=rp_airflow
REDPANDA_AIRFLOW_PASSWORD=replace_with_redpanda_airflow_password

# Excel scanner gating
EXCEL_MAX_BYTES=26214400
LOG_LEVEL=INFO

# Airflow metadata DB (isolated from event_store_db and fintech platform pg)
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=replace_with_airflow_db_password
AIRFLOW_ADMIN_USER=meridian_airflow_admin
AIRFLOW_ADMIN_PASSWORD=replace_with_airflow_admin_password
# 32-byte urlsafe-base64; generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=replace_with_airflow_fernet_key
# 64+ hex chars; generate with: openssl rand -hex 32
AIRFLOW_WEBSERVER_SECRET_KEY=replace_with_airflow_webserver_secret_key

REDPANDA_CDC_SERVICE_USER=rp_cdc_service
REDPANDA_CDC_SERVICE_PASSWORD=replace_with_redpanda_cdc_service_password

REDPANDA_FRAUD_SERVICE_USER=rp_fraud_service
REDPANDA_FRAUD_SERVICE_PASSWORD=replace_with_redpanda_fraud_service_password

REDPANDA_SALESFORCE_SERVICE_USER=rp_salesforce_service
REDPANDA_SALESFORCE_SERVICE_PASSWORD=replace_with_redpanda_salesforce_service_password

REDPANDA_ORCHESTRATOR_SERVICE_USER=rp_orchestrator_service
REDPANDA_ORCHESTRATOR_SERVICE_PASSWORD=replace_with_redpanda_orchestrator_service_password

REDPANDA_UI_SERVICE_USER=rp_ui_service
REDPANDA_UI_SERVICE_PASSWORD=replace_with_redpanda_ui_service_password

# Event-store query user provisioned by Terraform
EVENT_QUERY_DB_USER=event_query_runtime
EVENT_QUERY_DB_PASSWORD=replace_with_event_query_db_password

# Event-store append user provisioned by Terraform
EVENT_APPEND_DB_USER=event_append_runtime
EVENT_APPEND_DB_PASSWORD=replace_with_event_append_db_password

# Keycloak runtime
KC_DB_USER=keycloak_runtime
KC_DB_PASSWORD=replace_with_keycloak_db_password
KC_ADMIN_USER=meridian_keycloak_admin
KC_ADMIN_PASSWORD=replace_with_keycloak_admin_password

# Keycloak realm/client settings
KEYCLOAK_REALM=meridian
KEYCLOAK_DEMO_SERVICE_CLIENT_ID=meridian-demo-service
KEYCLOAK_DEMO_SERVICE_CLIENT_SECRET=replace_with_demo_service_client_secret
KEYCLOAK_DEMO_USER_PASSWORD=replace_with_demo_user_password

# MinIO root and IAM configuration (Terraform)
MINIO_ROOT_PASSWORD=replace_with_minio_pass
MINIO_ROOT_USER=meridian_minio_admin
MINIO_BUCKET_NAME=fintech-lakehouse
MINIO_INGEST_UPLOAD_TOPIC=ingest.excel.uploaded.v1

MINIO_INGEST_USER=minio_ingest
MINIO_INGEST_SECRET=replace_with_minio_ingest_secret

MINIO_VALIDATION_USER=minio_validation
MINIO_VALIDATION_SECRET=replace_with_minio_validation_secret

MINIO_TRANSFORM_USER=minio_transform
MINIO_TRANSFORM_SECRET=replace_with_minio_transform_secret

MINIO_TRINO_WRITE_USER=minio_trino_write
MINIO_TRINO_WRITE_SECRET=replace_with_minio_trino_write_secret

MINIO_TRINO_READ_USER=minio_trino_read
MINIO_TRINO_READ_SECRET=replace_with_minio_trino_read_secret

# Vault + KES (SSE-KMS baseline)
VAULT_DEV_ROOT_TOKEN_ID=replace_with_vault_root_token
VAULT_KV_ENGINE=kv
VAULT_TRANSIT_ENGINE=transit
VAULT_TRANSIT_KEY_NAME=fintech-minio-kms-root
KES_VAULT_APPROLE=kes-minio
KES_VAULT_POLICY=kes-minio-policy
KES_VAULT_PREFIX=fintech-kes
MINIO_KMS_KEY_ID=fintech-lakehouse-kms-key
# Generate once: docker run --rm minio/kes:latest identity new
MINIO_KMS_KES_API_KEY=replace_with_kes_api_key
MINIO_KMS_KES_IDENTITY=replace_with_kes_identity_hash
MINIO_ENFORCE_KMS_WRITE_PREFIXES=true

# Demo UI (React SPA served by nginx on :3000)
UI_ORIGIN=http://localhost:3000
UI_API_URL=http://localhost:8000
DEMO_FINANCE_USERS=james.beringer@meridian.example.com,kathy.winston@meridian.example.com,alex.ortiz@meridian.example.com
