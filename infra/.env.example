# PostgreSQL configuration info
POSTGRES_DB=replace_with_pg_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# PostreSQL root user login
POSTGRES_ROOT_PASSWORD=replace_with_pg_pass
POSTGRES_ROOT_USER=replace_with_pg_user

# Runtime DB login users — created automatically on first container init by 05_create_login_roles.sql
# Must match OPERATOR_DB_USER / OBSERVER_DB_USER in backend/.env
OPERATOR_DB_USER=replace_with_operator_db_user
OPERATOR_DB_PASSWORD=replace_with_operator_db_password

OBSERVER_DB_USER=replace_with_observer_db_user
OBSERVER_DB_PASSWORD=replace_with_observer_db_password

PIPELINE_DB_USER=replace_with_pipeline_db_user
PIPELINE_DB_PASSWORD=replace_with_pipeline_db_password

AUTH_DB_USER=api_auth
AUTH_DB_PASSWORD=replace_with_auth_db_password

# Seed passwords — used by `make seed-principals` only, not by the running API
OPERATOR_PASSWORD=replace_with_operator_password
OBSERVER_PASSWORD=replace_with_observer_password
PIPELINE_PASSWORD=replace_with_pipeline_password

# MinIO user configuration
MINIO_ROOT_PASSWORD=replace_with_minio_pass
MINIO_ROOT_USER=replace_with_minio_user