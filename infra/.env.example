# PostgreSQL configuration info
POSTGRES_DB=fintech_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# PostreSQL root user login
POSTGRES_ROOT_PASSWORD=replace_with_pg_pass
POSTGRES_ROOT_USER=fintech_platform_admin

# Runtime DB login users provisioned by Terraform
OPERATOR_DB_USER=api_runtime
OPERATOR_DB_PASSWORD=replace_with_operator_db_password

OBSERVER_DB_USER=audit_runtime
OBSERVER_DB_PASSWORD=replace_with_observer_db_password

PIPELINE_DB_USER=api_pipeline
PIPELINE_DB_PASSWORD=replace_with_pipeline_db_password

# Keycloak runtime
KC_DB_USER=keycloak_runtime
KC_DB_PASSWORD=replace_with_keycloak_db_password
KC_ADMIN_USER=meridian_keycloak_admin
KC_ADMIN_PASSWORD=replace_with_keycloak_admin_password

# Keycloak realm/client settings
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=meridian
KEYCLOAK_API_CLIENT_ID=meridian-api
KEYCLOAK_API_AUDIENCE=meridian-api
KEYCLOAK_SWAGGER_CLIENT_ID=meridian-api

# Keycloak local seeded users (operator/observer)
KEYCLOAK_OPERATOR_USER=operator
KEYCLOAK_OPERATOR_PASSWORD=replace_with_operator_login_password
KEYCLOAK_OBSERVER_USER=observer
KEYCLOAK_OBSERVER_PASSWORD=replace_with_observer_login_password

# Keycloak confidential pipeline client secret
KC_PIPELINE_CLIENT_SECRET=replace_with_keycloak_pipeline_client_secret

# MinIO root and IAM configuration (Terraform)
MINIO_SERVER=localhost:9000
MINIO_ROOT_PASSWORD=replace_with_minio_pass
MINIO_ROOT_USER=meridian_minio_admin
MINIO_BUCKET_NAME=fintech-lakehouse

MINIO_INGEST_USER=minio_ingest
MINIO_INGEST_SECRET=replace_with_minio_ingest_secret

MINIO_TRANSFORM_USER=minio_transform
MINIO_TRANSFORM_SECRET=replace_with_minio_transform_secret

MINIO_TRINO_WRITE_USER=minio_trino_write
MINIO_TRINO_WRITE_SECRET=replace_with_minio_trino_write_secret

MINIO_TRINO_READ_USER=minio_trino_read
MINIO_TRINO_READ_SECRET=replace_with_minio_trino_read_secret
