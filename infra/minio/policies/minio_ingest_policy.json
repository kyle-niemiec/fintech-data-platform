{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListAllowedPrefixes",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::fintech-lakehouse"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "landing/*",
            "raw/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadWriteLandingRawObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::fintech-lakehouse/landing/*",
        "arn:aws:s3:::fintech-lakehouse/raw/*"
      ]
    }
  ]
}
