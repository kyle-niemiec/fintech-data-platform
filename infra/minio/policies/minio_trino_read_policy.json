{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBIPrefixes",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::fintech-lakehouse"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "silver/*",
            "gold/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadBILayers",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::fintech-lakehouse/silver/*",
        "arn:aws:s3:::fintech-lakehouse/gold/*"
      ]
    }
  ]
}
