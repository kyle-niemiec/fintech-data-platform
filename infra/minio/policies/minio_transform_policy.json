{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTransformPrefixes",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::fintech-lakehouse"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "raw/*",
            "bronze/*",
            "silver/*",
            "gold/*",
            "quarantine/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadRawObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::fintech-lakehouse/raw/*"
      ]
    },
    {
      "Sid": "WriteCuratedLayers",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::fintech-lakehouse/bronze/*",
        "arn:aws:s3:::fintech-lakehouse/silver/*",
        "arn:aws:s3:::fintech-lakehouse/gold/*",
        "arn:aws:s3:::fintech-lakehouse/quarantine/*"
      ]
    }
  ]
}
