{
  "catalogs": [
    {
      "user": "trino_etl",
      "catalog": ".*",
      "allow": "all"
    },
    {
      "user": "data_engineer",
      "catalog": "lakehouse",
      "allow": "all"
    },
    {
      "user": "analyst",
      "catalog": "lakehouse",
      "allow": "read-only"
    },
    {
      "user": "executive",
      "catalog": "lakehouse",
      "allow": "read-only"
    }
  ],
  "schemas": [
    {
      "user": "data_engineer",
      "schema": ".*",
      "owner": true
    },
    {
      "user": "analyst",
      "schema": "silver",
      "owner": false
    },
    {
      "user": "executive",
      "schema": "gold",
      "owner": false
    }
  ],
  "tables": [
    {
      "user": "data_engineer",
      "schema": ".*",
      "table": ".*",
      "privileges": ["SELECT", "INSERT", "DELETE", "UPDATE", "OWNERSHIP"]
    },
    {
      "user": "analyst",
      "schema": "silver",
      "table": ".*",
      "privileges": ["SELECT"]
    },
    {
      "user": "executive",
      "schema": "gold",
      "table": ".*",
      "privileges": ["SELECT"]
    }
  ]
}
